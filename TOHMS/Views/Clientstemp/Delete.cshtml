@model TOHMS.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body">

            <h1 class="text-danger">Delete Client</h1>

            <p>
                Are you sure you want to delete this client?
            </p>

            <div class="alert alert-warning">
                <strong>@Model.CompanyName</strong>
                <br />
                @Model.ContactPerson
                <br />
                @Model.Email
            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="ClientId" />

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>