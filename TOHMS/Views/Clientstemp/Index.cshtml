@model IEnumerable<TOHMS.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="dashboard-header">

    <div class="dashboard-title">
        <h1>Clients</h1>
        <p>
            Manage companies receiving occupational health
            services from Thahla Occuhealth.
        </p>
    </div>

    <div>
        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-building-add me-1"></i>
            Add Client
        </a>
    </div>

</div>


<div class="card">

    <div class="card-header d-flex
        justify-content-between
        align-items-center">

        <span>
            <i class="bi bi-buildings me-2"></i>
            Registered Clients
        </span>

        <span class="badge bg-secondary">
            @Model.Count() Total
        </span>

    </div>


    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-buildings
                fs-1 text-muted"></i>

                <h4 class="mt-3">
                    No clients registered
                </h4>

                <p class="text-muted">
                    Register your first client company
                    to begin managing occupational
                    health services.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Register Client

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive border-0
                shadow-none rounded-0">

                <table class="table table-hover
                    align-middle">

                    <thead>

                        <tr>
                            <th>Company</th>
                            <th>Contact Person</th>
                            <th>Industry</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>

                            <th class="text-end">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var client in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @client.CompanyName
                                    </strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        client.ContactPerson)
                                        ? "—"
                                        : client.ContactPerson)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        client.Industry)
                                        ? "—"
                                        : client.Industry)
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        client.Email))
                                    {
                                        <a href="mailto:@client.Email">
                                            @client.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        client.PhoneNumber)
                                        ? "—"
                                        : client.PhoneNumber)
                                </td>

                                <td>

                                    @if (client.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="btn-group"
                                         role="group"
                                         aria-label="Client actions">

                                        <a asp-action="Details"
                                           asp-route-id="@client.ClientId"
                                           class="btn btn-sm
                                            btn-outline-primary"
                                           title="View client">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@client.ClientId"
                                           class="btn btn-sm
                                            btn-outline-secondary"
                                           title="Edit client">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@client.ClientId"
                                           class="btn btn-sm
                                            btn-outline-danger"
                                           title="Delete client">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>