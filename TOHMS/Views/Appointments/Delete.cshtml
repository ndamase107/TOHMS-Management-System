@model TOHMS.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-danger shadow-sm">

                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        Delete Appointment
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        Are you sure you want to delete this appointment?
                        This action cannot be undone.
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">Employee</dt>
                        <dd class="col-sm-8">
                            @Model.Employee?.FirstName
                            @Model.Employee?.LastName
                        </dd>

                        <dt class="col-sm-4">Company</dt>
                        <dd class="col-sm-8">
                            @Model.Employee?.Client?.CompanyName
                        </dd>

                        <dt class="col-sm-4">Appointment</dt>
                        <dd class="col-sm-8">
                            @Model.AppointmentType
                        </dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">
                            @Model.AppointmentDate.ToString("dd MMMM yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @Model.Status
                        </dd>

                    </dl>

                    <form asp-action="Delete"
                          asp-route-id="@Model.AppointmentId"
                          method="post">

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Appointment
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>