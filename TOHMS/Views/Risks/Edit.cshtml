@model TOHMS.Models.Risk

@{
    ViewData["Title"] = "Edit Risk Assessment";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-white">
                    <h3>Edit Risk Assessment</h3>
                </div>

                <div class="card-body">

                    <form asp-action="Edit"
                          asp-route-id="@Model.RiskId"
                          method="post">

                        <input asp-for="RiskId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="ClientId"
                                   class="form-label">
                                Client Company
                            </label>

                            <select asp-for="ClientId"
                                    asp-items="ViewBag.Clients"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="ClientId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Hazard"
                                   class="form-label">
                                Hazard
                            </label>

                            <input asp-for="Hazard"
                                   class="form-control"
                                   placeholder="Describe the workplace hazard" />

                            <span asp-validation-for="Hazard"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="RiskLevel"
                                   class="form-label">
                                Risk Level
                            </label>

                            <select asp-for="RiskLevel"
                                    class="form-select">

                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>

                            </select>

                            <span asp-validation-for="RiskLevel"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ControlMeasures"
                                   class="form-label">
                                Control Measures
                            </label>

                            <textarea asp-for="ControlMeasures"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe measures used to control the risk">
                            </textarea>

                            <span asp-validation-for="ControlMeasures"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="AssessmentDate"
                                   class="form-label">
                                Assessment Date
                            </label>

                            <input asp-for="AssessmentDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="AssessmentDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active Risk
                            </label>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}