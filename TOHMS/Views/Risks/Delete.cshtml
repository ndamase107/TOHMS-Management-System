@model TOHMS.Models.Risk

@{
    ViewData["Title"] = "Delete Risk";
}

<div class="container mt-4">

    <div class="card border-danger shadow-sm">

        <div class="card-header bg-danger text-white">
            <h3>Delete Risk Assessment</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this risk assessment?
            </div>

            <p><strong>Company:</strong> @Model.Client?.CompanyName</p>
            <p><strong>Hazard:</strong> @Model.Hazard</p>
            <p><strong>Risk Level:</strong> @Model.RiskLevel</p>

            <form asp-action="Delete"
                  asp-route-id="@Model.RiskId"
                  method="post">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    Delete Assessment
                </button>

            </form>

        </div>

    </div>

</div>