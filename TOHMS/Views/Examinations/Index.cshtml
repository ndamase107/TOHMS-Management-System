@model IEnumerable<TOHMS.Models.Examination>

@{
    ViewData["Title"] = "Examinations";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Medical Examinations</h2>
            <p class="text-muted">
                Manage employee occupational health examinations.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Record Examination
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Company</th>
                            <th>Examination</th>
                            <th>Fitness Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.ExaminationDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @item.Employee?.FirstName
                                    @item.Employee?.LastName
                                </td>

                                <td>
                                    @item.Employee?.Client?.CompanyName
                                </td>

                                <td>@item.ExaminationType</td>

                                <td>
                                    @if (item.FitnessStatus == "Fit")
                                    {
                                        <span class="badge bg-success">Fit</span>
                                    }
                                    else if (item.FitnessStatus == "Unfit")
                                    {
                                        <span class="badge bg-danger">Unfit</span>
                                    }
                                    else if (item.FitnessStatus == "Fit with Restrictions")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Fit with Restrictions
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.FitnessStatus
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@item.ExaminationId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ExaminationId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ExaminationId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>