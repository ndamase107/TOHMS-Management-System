@model TOHMS.Models.InvoiceItem

@{
    ViewData["Title"] = "Add Service";
    var invoice = ViewBag.Invoice as TOHMS.Models.Invoice;
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-header bg-white">

                    <h3>Add Service to Invoice</h3>

                    <p class="text-muted mb-0">
                        @invoice?.InvoiceNumber
                    </p>

                </div>

                <div class="card-body">

                    <form asp-action="AddItem"
                          method="post">

                        <input asp-for="InvoiceId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="ServiceId"
                                   class="form-label">
                                Occupational Health Service
                            </label>

                            <select asp-for="ServiceId"
                                    asp-items="ViewBag.Services"
                                    class="form-select">

                                <option value="">
                                    -- Select Service --
                                </option>

                            </select>

                            <span asp-validation-for="ServiceId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Quantity"
                                   class="form-label">
                                Quantity
                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-info">
                            The service price and total will
                            be calculated automatically.
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Details"
                               asp-route-id="@Model.InvoiceId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Add Service
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}