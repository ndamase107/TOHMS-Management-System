@model TOHMS.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-danger shadow-sm">

                <div class="card-header bg-danger text-white">
                    <h3>Delete Invoice</h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        This will permanently delete the invoice
                        and all of its invoice items.
                    </div>

                    <p>
                        <strong>Invoice:</strong>
                        @Model.InvoiceNumber
                    </p>

                    <p>
                        <strong>Client:</strong>
                        @Model.Client?.CompanyName
                    </p>

                    <p>
                        <strong>Total:</strong>
                        R @Model.TotalAmount.ToString("N2")
                    </p>

                    <p>
                        <strong>Status:</strong>
                        @Model.Status
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.InvoiceId"
                          method="post">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-danger">
                            Delete Invoice
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>