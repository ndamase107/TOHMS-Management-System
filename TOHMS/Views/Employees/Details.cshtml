@model TOHMS.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>
                @Model.FirstName @Model.LastName
            </h1>

            <p class="text-muted">
                Employee Details
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.EmployeeId"
               class="btn btn-primary">
                Edit Employee
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Employee Number</strong>
                    <p>@Model.EmployeeNumber</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Client Company</strong>
                    <p>@Model.Client?.CompanyName</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>First Name</strong>
                    <p>@Model.FirstName</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Last Name</strong>
                    <p>@Model.LastName</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>ID Number</strong>
                    <p>@Model.IDNumber</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Date of Birth</strong>
                    <p>@Model.DateOfBirth.ToShortDateString()</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Employment Date</strong>
                    <p>@Model.EmploymentDate.ToShortDateString()</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Job Title</strong>
                    <p>@Model.JobTitle</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Department</strong>
                    <p>@Model.Department</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Phone</strong>
                    <p>@Model.PhoneNumber</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Email</strong>
                    <p>@Model.Email</p>
                </div>

                <div class="col-md-6">
                    <strong>Status</strong>

                    @if (Model.IsActive)
                    {
                        <p>
                            <span class="badge bg-success">
                                Active
                            </span>
                        </p>
                    }
                    else
                    {
                        <p>
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        </p>
                    }
                </div>

            </div>

        </div>

    </div>

</div>