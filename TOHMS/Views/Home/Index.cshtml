@model TOHMS.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-header">

    <div class="dashboard-title">
        <h1>
            Occupational Health Dashboard
        </h1>

        <p>
            Overview of Thahla Occuhealth operations and
            occupational health activities.
        </p>
    </div>

    <div>
        <span class="badge bg-success">
            <i class="bi bi-circle-fill me-1"></i>
            System Operational
        </span>
    </div>

</div>


<!-- PRIMARY STATISTICS -->

<div class="row g-4 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">

        <a asp-controller="Clients"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card stat-card">

                <div class="card-body">

                    <div>
                        <span class="stat-label">
                            Clients
                        </span>

                        <span class="stat-number">
                            @Model.TotalClients
                        </span>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-buildings"></i>
                    </div>

                </div>

            </div>

        </a>

    </div>


    <div class="col-12 col-sm-6 col-xl-3">

        <a asp-controller="Employees"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card stat-card">

                <div class="card-body">

                    <div>
                        <span class="stat-label">
                            Employees
                        </span>

                        <span class="stat-number">
                            @Model.TotalEmployees
                        </span>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                </div>

            </div>

        </a>

    </div>


    <div class="col-12 col-sm-6 col-xl-3">

        <a asp-controller="Appointments"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card stat-card">

                <div class="card-body">

                    <div>
                        <span class="stat-label">
                            Appointments
                        </span>

                        <span class="stat-number">
                            @Model.TotalAppointments
                        </span>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                </div>

            </div>

        </a>

    </div>


    <div class="col-12 col-sm-6 col-xl-3">

        <a asp-controller="Billing"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card stat-card">

                <div class="card-body">

                    <div>
                        <span class="stat-label">
                            Invoices
                        </span>

                        <span class="stat-number">
                            @Model.TotalInvoices
                        </span>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                </div>

            </div>

        </a>

    </div>

</div>


<!-- OPERATIONAL INFORMATION -->

<div class="row g-4 mb-4">

    <div class="col-12 col-lg-7">

        <div class="card h-100">

            <div class="card-header">
                <i class="bi bi-activity me-2"></i>
                Occupational Health Overview
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-12 col-md-6">

                        <div class="p-3 border rounded-3">

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <div>
                                    <small class="text-muted">
                                        Upcoming Appointments
                                    </small>

                                    <h3 class="mb-0 mt-1">
                                        @Model.UpcomingAppointments
                                    </h3>
                                </div>

                                <i class="bi bi-calendar-event
                                fs-3 text-primary"></i>

                            </div>

                        </div>

                    </div>


                    <div class="col-12 col-md-6">

                        <div class="p-3 border rounded-3">

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <div>
                                    <small class="text-muted">
                                        Pending Examinations
                                    </small>

                                    <h3 class="mb-0 mt-1">
                                        @Model.PendingExaminations
                                    </h3>
                                </div>

                                <i class="bi bi-clipboard2-pulse
                                fs-3 text-warning"></i>

                            </div>

                        </div>

                    </div>


                    <div class="col-12 col-md-6">

                        <div class="p-3 border rounded-3">

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <div>
                                    <small class="text-muted">
                                        Active Certificates
                                    </small>

                                    <h3 class="mb-0 mt-1">
                                        @Model.ActiveCertificates
                                    </h3>
                                </div>

                                <i class="bi bi-patch-check
                                fs-3 text-success"></i>

                            </div>

                        </div>

                    </div>


                    <div class="col-12 col-md-6">

                        <div class="p-3 border rounded-3">

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <div>
                                    <small class="text-muted">
                                        Open Workplace Risks
                                    </small>

                                    <h3 class="mb-0 mt-1">
                                        @Model.OpenRisks
                                    </h3>
                                </div>

                                <i class="bi bi-shield-exclamation
                                fs-3 text-danger"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- QUICK ACTIONS -->

    <div class="col-12 col-lg-5">

        <div class="card h-100">

            <div class="card-header">
                <i class="bi bi-lightning-charge-fill me-2"></i>
                Quick Actions
            </div>

            <div class="card-body">

                <div class="d-grid gap-2">

                    <a asp-controller="Clients"
                       asp-action="Create"
                       class="btn btn-primary text-start">

                        <i class="bi bi-building-add me-2"></i>
                        Register New Client
                    </a>


                    <a asp-controller="Employees"
                       asp-action="Create"
                       class="btn btn-outline-primary text-start">

                        <i class="bi bi-person-plus me-2"></i>
                        Register Employee
                    </a>


                    <a asp-controller="Appointments"
                       asp-action="Create"
                       class="btn btn-outline-primary text-start">

                        <i class="bi bi-calendar-plus me-2"></i>
                        Schedule Appointment
                    </a>


                    <a asp-controller="Examinations"
                       asp-action="Create"
                       class="btn btn-outline-primary text-start">

                        <i class="bi bi-clipboard2-plus me-2"></i>
                        Record Examination
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- MANAGEMENT INFORMATION -->

<div class="row g-4">

    <div class="col-12 col-md-6">

        <div class="card h-100">

            <div class="card-body">

                <div class="d-flex
                    align-items-center
                    justify-content-between">

                    <div>
                        <small class="text-muted">
                            Outstanding Invoices
                        </small>

                        <h2 class="mb-1 mt-1">
                            @Model.OutstandingInvoices
                        </h2>

                        <a asp-controller="Billing"
                           asp-action="Index"
                           class="small">

                            View billing
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-12 col-md-6">

        <div class="card h-100">

            <div class="card-body">

                <div class="d-flex
                    align-items-center
                    justify-content-between">

                    <div>
                        <small class="text-muted">
                            Risk Assessments
                        </small>

                        <h2 class="mb-1 mt-1">
                            @Model.TotalRisks
                        </h2>

                        <a asp-controller="Risks"
                           asp-action="Index"
                           class="small">

                            Manage workplace risks
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    <div class="stat-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>