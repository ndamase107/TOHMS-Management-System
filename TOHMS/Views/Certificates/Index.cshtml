@model IEnumerable<TOHMS.Models.Certificate>

@{
    ViewData["Title"] = "Certificates";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Medical Certificates</h2>
            <p class="text-muted">
                Manage employee occupational health certificates.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Issue Certificate
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Certificate #</th>
                            <th>Employee</th>
                            <th>Company</th>
                            <th>Type</th>
                            <th>Issue Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.CertificateNumber</td>

                                <td>
                                    @item.Employee?.FirstName
                                    @item.Employee?.LastName
                                </td>

                                <td>
                                    @item.Employee?.Client?.CompanyName
                                </td>

                                <td>@item.CertificateType</td>

                                <td>
                                    @item.IssueDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span class="badge bg-danger">
                                            Expired
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@item.CertificateId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.CertificateId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.CertificateId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>
</div>