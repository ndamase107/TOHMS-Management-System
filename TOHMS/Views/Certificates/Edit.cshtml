@model TOHMS.Models.Certificate

@{
    ViewData["Title"] = "Edit Certificate";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-white">
                    <h3>Edit Medical Certificate</h3>
                </div>

                <div class="card-body">

                    <form asp-action="Edit"
                          asp-route-id="@Model.CertificateId"
                          method="post">

                        <input asp-for="CertificateId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="EmployeeId"
                                   class="form-label">
                                Employee
                            </label>

                            <select asp-for="EmployeeId"
                                    asp-items="ViewBag.Employees"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="EmployeeId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="CertificateNumber"
                                   class="form-label">
                                Certificate Number
                            </label>

                            <input asp-for="CertificateNumber"
                                   class="form-control"
                                   placeholder="e.g. TOHMS-2026-001" />

                            <span asp-validation-for="CertificateNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="CertificateType"
                                   class="form-label">
                                Certificate Type
                            </label>

                            <select asp-for="CertificateType"
                                    class="form-select">

                                <option value="Certificate of Fitness">
                                    Certificate of Fitness
                                </option>

                                <option value="Medical Fitness Certificate">
                                    Medical Fitness Certificate
                                </option>

                                <option value="Return to Work Certificate">
                                    Return to Work Certificate
                                </option>

                                <option value="Restricted Duty Certificate">
                                    Restricted Duty Certificate
                                </option>

                                <option value="Occupational Health Certificate">
                                    Occupational Health Certificate
                                </option>

                            </select>

                            <span asp-validation-for="CertificateType"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="IssueDate"
                                       class="form-label">
                                    Issue Date
                                </label>

                                <input asp-for="IssueDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="IssueDate"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="ExpiryDate"
                                       class="form-label">
                                    Expiry Date
                                </label>

                                <input asp-for="ExpiryDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="ExpiryDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Status"
                                   class="form-label">
                                Status
                            </label>

                            <select asp-for="Status"
                                    class="form-select">

                                <option value="Active">Active</option>
                                <option value="Expired">Expired</option>
                                <option value="Suspended">Suspended</option>
                                <option value="Revoked">Revoked</option>

                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}