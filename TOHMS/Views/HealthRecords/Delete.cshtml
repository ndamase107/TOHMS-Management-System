@model TOHMS.Models.HealthRecord

@{
    ViewData["Title"] = "Delete Health Record";
}

<div class="container mt-4">

    <div class="card border-danger shadow-sm">

        <div class="card-header bg-danger text-white">
            <h3>Delete Health Record</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to permanently delete this health record?
            </div>

            <p>
                <strong>Employee:</strong>
                @Model.Employee?.FirstName
                @Model.Employee?.LastName
            </p>

            <p>
                <strong>Company:</strong>
                @Model.Employee?.Client?.CompanyName
            </p>

            <p>
                <strong>Record Type:</strong>
                @Model.RecordType
            </p>

            <p>
                <strong>Date:</strong>
                @Model.RecordDate.ToString("dd MMMM yyyy")
            </p>

            <form asp-action="Delete"
                  asp-route-id="@Model.HealthRecordId"
                  method="post">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    Delete Health Record
                </button>

            </form>

        </div>

    </div>

</div>